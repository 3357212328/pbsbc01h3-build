+static int proc_parse_subset_param(struct fs_context *fc, const char *value)
+{
+	struct proc_fs_context *ctx = fc->fs_private;
+
+	while (value) {
+		char *ptr = strchr(value, ',');
+		size_t len = ptr ? (size_t)(ptr - value) : strlen(value);
+
+		if (len == 3 && !strncmp(value, "all", 3))
+			ctx->subset = 0;
+		else if (len == 3 && !strncmp(value, "pid", 3))
+			ctx->subset = 1;
+		else if (len > 0)
+			return invalf(fc, "proc: unsupported subset option\n");
+
+		value = ptr ? ptr + 1 : NULL;
+	}
+	return 0;
+}
