# pbsbc01h3 resize filesystem service
# Resizes partition and filesystem on first/second boot
# This service may block the boot process for up to 3 minutes

[Unit]
Description=pbsbc01h3 filesystem resize
Before=basic.target
After=sysinit.target local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/pbsbc01h3/pbsbc01h3-resize-filesystem start
TimeoutStartSec=6min

[Install]
WantedBy=basic.target
