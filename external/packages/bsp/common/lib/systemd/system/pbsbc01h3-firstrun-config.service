# pbsbc01h3 firstrun configuration service
# This service will run in parallel with other services

[Unit]
Description=pbsbc01h3 first run optional user configuration
Wants=network-online.target
After=network.target network-online.target
ConditionPathExists=/boot/pbsbc01h3_first_run.txt
ConditionPathExists=/root/.not_logged_in_yet

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/pbsbc01h3/pbsbc01h3-firstrun-config
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
