# pbsbc01h3 hardware optimization service
# Apply optimisations
# This service may block the boot process for up to 2 minutes

[Unit]
Description=pbsbc01h3 hardware optimization
Before=basic.target
After=sysinit.target local-fs.target pbsbc01h3-hardware-monitor.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/lib/pbsbc01h3/pbsbc01h3-hardware-optimization start
ExecStop=/usr/lib/pbsbc01h3/pbsbc01h3-hardware-optimization stop
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=basic.target
