# pbsbc01h3 firstrun service
# Regenerates the SSH keys and performs additional first run tweaks
# This service will run in parallel with other services

[Unit]
Description=pbsbc01h3 first run tasks
Before=getty.target system-getty.slice

[Service]
Type=simple
RemainAfterExit=yes
ExecStart=/usr/lib/pbsbc01h3/pbsbc01h3-firstrun start
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target

